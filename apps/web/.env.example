# The storefront talks to this app's own mock by default. For the real Munim API, set both values the founder
# sends and remove NEXT_PUBLIC_MUNIM_MOCK_CONTROLS.
NEXT_PUBLIC_MUNIM_API=/mock
NEXT_PUBLIC_MUNIM_STOREFRONT_KEY=sfk_mock_cobnut_bakehouse_5b1e7d40
NEXT_PUBLIC_MUNIM_MOCK_CONTROLS=1
# Optional: signs the mock's guest tokens (any long random string). Not used with the real API.
MOCK_TOKEN_SECRET=
