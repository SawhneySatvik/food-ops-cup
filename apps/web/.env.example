# apps/web settings. These defaults run the site on its own in-app mock; every value here is public.
# Production (munim-cobnut) sets NEXT_PUBLIC_MUNIM_API=/api and MUNIM_API_ORIGIN, never MUNIM_MOCK. See README.md.

# Where the browser sends API calls: /mock (the in-app mock) or /api (Munim's API on this site's origin).
NEXT_PUBLIC_MUNIM_API=/mock
# Cobnut's storefront key (public by design). This one is the mock's; the Cobnut world seed prints the real one.
NEXT_PUBLIC_MUNIM_STOREFRONT_KEY=sfk_mock_cobnut_bakehouse_5b1e7d40
# 1 shows the mock's test controls. Only with the mock.
NEXT_PUBLIC_MUNIM_MOCK_CONTROLS=1
# 1 serves the mock at /mock/v1/*; otherwise those routes answer 404.
MUNIM_MOCK=1
# Optional: signs the mock's guest tokens (any long random string).
MOCK_TOKEN_SECRET=

# Production only: /api/* is rewritten to this origin (e.g. http://127.0.0.1:8790 for a local core-api).
MUNIM_API_ORIGIN=

# The demo picker's server sign-in on the real API (POST /staff/demo-session). 1 turns it on.
MUNIM_DEMO_SIGNIN=
# The Cobnut tenant the picker signs into (from the world seed; change it to point at a reseeded tenant).
MUNIM_DEMO_TENANT_ID=
# How the picker signs a person in, as core-api verifies them: identity-platform, or local (development only).
MUNIM_IDP=
# identity-platform: the web API key (public by design) and the demo accounts' password (a secret: set it in the
# host's settings, never here).
MUNIM_IDP_WEB_API_KEY=
MUNIM_DEMO_PASSWORD=
# local: a JSON file {"owner","manager","counter","kitchen"} of tokens.
MUNIM_DEMO_TOKENS=
