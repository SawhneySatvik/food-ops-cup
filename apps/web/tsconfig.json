{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["web-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "next-env.d.ts", ".next", ".next-*"]
}
