# Settings an env file may hold for running the services locally (packages/config reads exactly these names).
# On Cloud Run every setting comes from the service's environment and Secret Manager instead (infra/gcp/README.md).

# --- AI providers (only with MUNIM_MODEL_MODE=live; every test runs on recorded responses) ---
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# --- Postgres: base URLs (host, port, database). The migration CLIs use MUNIM_DB_URL_SESSION as an admin URL;
# --- at run time each role logs in as itself with MUNIM_DB_PASSWORD_<ROLE>.
MUNIM_DB_URL_SESSION=
MUNIM_DB_URL_TRANSACTION=
