{
  "name": "@munim/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./grammar": "./src/shared/grammar/index.ts",
    "./grammar/number-words.json": "./src/shared/grammar/number-words.json",
    "./packs/*.json": "./packs/*.json",
