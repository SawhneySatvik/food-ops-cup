  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
