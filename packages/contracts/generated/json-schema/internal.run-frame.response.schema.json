{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.run-frame.response",
  "title": "InternalRunFrameResponse",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "pack": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "version"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "severity_ladder": {
      "type": "object",
      "properties": {
        "critical_minor_gte": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "high_minor_gte": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "medium_minor_gte": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "critical_minor_gte",
        "high_minor_gte",
        "medium_minor_gte"
      ],
      "additionalProperties": false
    },
    "detectors": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "thresholds": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "thresholds"
        ],
        "additionalProperties": false
      }
    },
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "cloud_kitchen",
              "store"
            ]
          },
          "tz": {
            "type": "string",
            "pattern": "^[A-Za-z]+\\/[A-Za-z_]+$"
          },
          "business_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
          },
          "cares_active": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "tz",
          "business_date"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "owner_cap_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "operator_limit_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "effective_cap_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "spent_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "hard_left_minor": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "level": {
              "type": "string",
              "enum": [
                "ok",
                "hard"
              ]
            }
          },
          "required": [
            "month",
            "currency",
            "owner_cap_minor",
            "operator_limit_minor",
            "effective_cap_minor",
            "spent_minor",
            "hard_left_minor",
            "level"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "narration": {
      "type": "string",
      "enum": [
        "model",
        "template"
      ]
    },
    "ai_enabled": {
      "default": false,
      "type": "boolean"
    },
    "negotiation": {
      "type": "object",
      "properties": {
        "target_bp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "walkaway_bp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      },
      "required": [
        "target_bp",
        "walkaway_bp"
      ],
      "additionalProperties": false
    },
    "licence_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "holder": {
            "type": "string",
            "enum": [
              "business",
              "outlet"
            ]
          },
          "outlet_kinds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "restaurant",
                "cloud_kitchen",
                "store"
              ]
            }
          },
          "unverified": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "holder",
          "outlet_kinds",
          "unverified"
        ],
        "additionalProperties": false
      }
    },
    "payroll_scope": {
      "type": "string",
      "enum": [
        "drafts",
        "roster_only"
      ]
    }
  },
  "required": [
    "pack",
    "currency",
    "severity_ladder",
    "detectors",
    "outlets",
    "budget",
    "narration",
    "negotiation",
    "licence_kinds",
    "payroll_scope"
  ],
  "additionalProperties": false
}
