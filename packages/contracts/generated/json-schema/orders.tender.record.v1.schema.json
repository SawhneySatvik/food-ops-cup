{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orders.tender.record.v1",
  "title": "OrdersTenderRecordV1",
  "x-munim-module": "orders",
  "type": "object",
  "properties": {
    "tender_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "upi"
      ]
    },
    "tendered_minor": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "amount_minor": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tender_id",
    "order_id",
    "method",
    "tendered_minor",
    "amount_minor",
    "currency",
    "ref"
  ],
  "additionalProperties": false
}
