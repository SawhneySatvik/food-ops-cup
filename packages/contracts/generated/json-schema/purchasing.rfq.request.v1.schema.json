{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purchasing.rfq.request.v1",
  "title": "PurchasingRfqRequestV1",
  "x-munim-module": "purchasing",
  "type": "object",
  "properties": {
    "rfq_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ingredient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_ids": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  },
  "required": [
    "rfq_id",
    "ingredient_id",
    "outlet_ids"
  ],
  "additionalProperties": false
}
