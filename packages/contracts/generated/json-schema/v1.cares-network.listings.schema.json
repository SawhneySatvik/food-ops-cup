{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.cares-network.listings",
  "title": "V1CaresNetworkListings",
  "x-munim-module": "cares",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "listing_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "city_code": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "business_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "outlet_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pickup_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
          },
          "pickup_to": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
          },
          "tz": {
            "type": "string",
            "pattern": "^[A-Za-z]+\\/[A-Za-z_]+$"
          },
          "recipient_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "recipient_simulated": {
            "type": "boolean",
            "const": true
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line_no": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "food_kind": {
                  "type": "string",
                  "enum": [
                    "cooked",
                    "raw",
                    "packaged"
                  ]
                },
                "label_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "qty_milli": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]{0,15}$"
                },
                "expires_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "line_no",
                "food_kind",
                "label_key",
                "label",
                "qty_milli",
                "unit",
                "expires_on"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "listing_id",
          "city_code",
          "business_name",
          "outlet_name",
          "pickup_from",
          "pickup_to",
          "tz",
          "recipient_name",
          "recipient_simulated",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
