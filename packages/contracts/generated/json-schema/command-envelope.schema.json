{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-envelope",
  "title": "CommandEnvelope",
  "x-munim-module": "shared",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{8,100}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+\\.v[1-9][0-9]*$"
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "command_id",
    "idempotency_key",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
