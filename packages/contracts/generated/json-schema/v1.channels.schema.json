{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.channels",
  "title": "V1Channels",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "counter",
                  "table_qr",
                  "pickup",
                  "own_site"
                ]
              },
              {
                "type": "string",
                "pattern": "^aggregator:[a-z][a-z0-9_]*$"
              }
            ]
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "active"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "channels"
  ],
  "additionalProperties": false
}
