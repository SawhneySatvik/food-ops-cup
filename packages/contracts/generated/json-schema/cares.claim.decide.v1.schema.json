{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cares.claim.decide.v1",
  "title": "CaresClaimDecideV1",
  "x-munim-module": "cares",
  "type": "object",
  "properties": {
    "allocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "listing_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claim_tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "accepted",
        "declined"
      ]
    }
  },
  "required": [
    "allocation_id",
    "listing_id",
    "claim_tenant_id",
    "claim_id",
    "verdict"
  ],
  "additionalProperties": false
}
