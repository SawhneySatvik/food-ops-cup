{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.people.overtime.response",
  "title": "V1PeopleOvertimeResponse",
  "x-munim-module": "people",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "iso_week": {
            "type": "string",
            "pattern": "^[0-9]{4}-W[0-9]{2}$"
          },
          "rostered_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attended_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "extra_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "extra_cost_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "staff_id",
          "iso_week",
          "rostered_min",
          "attended_min",
          "extra_min",
          "extra_cost_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlet_id",
    "from",
    "to",
    "rows"
  ],
  "additionalProperties": false
}
