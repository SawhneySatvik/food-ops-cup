{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "threads.block",
  "title": "ThreadsBlock",
  "x-munim-module": "threads",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "summary_refs": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "answer_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "segment": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:row:[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:doc|msg|claim|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}))$"
            }
          }
        },
        "required": [
          "turn_no",
          "answer_id",
          "segment",
          "refs"
        ],
        "additionalProperties": false
      }
    },
    "last_turn_ids": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "tainted": {
      "type": "boolean"
    }
  },
  "required": [
    "thread_id",
    "summary_refs",
    "last_turn_ids",
    "tainted"
  ],
  "additionalProperties": false
}
