{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.kitchen.prep_list",
  "title": "V1KitchenPrepList",
  "x-munim-module": "kitchen",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "business_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    },
    "state": {
      "type": "string",
      "enum": [
        "approved",
        "waiting",
        "none",
        "cannot_verify"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "number_grammar",
            "unresolved_ref",
            "cross_tenant_ref",
            "quote_mismatch",
            "missing_ref",
            "settlements_missing",
            "recipe_missing",
            "stale_draft",
            "authority_denied",
            "cost_price_missing",
            "ticket_times_missing",
            "count_missing",
            "expiry_missing",
            "budget_exceeded",
            "budget_missing",
            "margin_below_floor",
            "moq_exceeds_need",
            "open_commitment_overlap",
            "payment_terms_worse",
            "consent_record_missing",
            "bank_lines_missing",
            "attendance_missing",
            "payroll_out_of_scope",
            "no_marketing_consent",
            "not_a_certificate",
            "log_coverage_missing",
            "signal_source_missing",
            "insufficient_history",
            "forecast_stale",
            "window_full",
            "outlet_paused",
            "item_sold_out",
            "deal_rejudged",
            "coupon_invalid",
            "coupon_cap_reached",
            "coupon_min_spend",
            "change_window_closed",
            "price_above_mrp",
            "expired_batch",
            "period_closed",
            "model_blocked",
            "preview_total_changed",
            "buyer_identity_required",
            "tax_id_missing",
            "unknown_tax_class",
            "unknown_channel",
            "unit_mismatch",
            "not_applicable",
            "item_unavailable",
            "reason_required",
            "deal_changed",
            "duplicate_invoice",
            "guest_cannot_change"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prep_list": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "prep_list_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "open",
                "done",
                "cancelled"
              ]
            },
            "draft_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ingredient_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "item_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "qty_milli": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "unit": {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]{0,15}$"
                  }
                },
                "required": [
                  "ingredient_id",
                  "item_id",
                  "qty_milli",
                  "unit"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "prep_list_id",
            "status",
            "draft_id",
            "lines"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "outlet_id",
    "business_date",
    "state",
    "reason_code",
    "prep_list"
  ],
  "additionalProperties": false
}
