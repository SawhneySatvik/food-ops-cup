{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.specialists.response",
  "title": "V1SpecialistsResponse",
  "x-munim-module": "specialists",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "specialist",
              "manager",
              "service"
            ]
          },
          "name_key": {
            "type": "string",
            "minLength": 1
          },
          "desk_key": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$"
            }
          },
          "detectors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          },
          "draftables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          },
          "workflow_draftables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "name_key",
          "desk_key",
          "aliases",
          "detectors",
          "templates",
          "draftables",
          "workflow_draftables"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
