{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.inventory.movements",
  "title": "V1InventoryMovements",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "movements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "movement_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "outlet_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,15}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "receipt",
              "sale_consumption",
              "waste",
              "transfer_out",
              "transfer_in",
              "count_adjust",
              "supplier_return",
              "sale_return",
              "donation",
              "surplus_out",
              "surplus_in",
              "cares_reversal"
            ]
          },
          "ref_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^core\\.[a-z_]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ref_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_cost": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount_minor",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_cost_per_1000": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "amount_minor",
                  "currency"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "expired_sale_override_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
          }
        },
        "required": [
          "movement_id",
          "outlet_id",
          "ingredient_id",
          "batch_id",
          "qty_milli",
          "unit",
          "kind",
          "ref_type",
          "ref_id",
          "unit_cost",
          "unit_cost_per_1000",
          "expired_sale_override_id",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "movements",
    "next_cursor"
  ],
  "additionalProperties": false
}
