{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.ai.policy",
  "title": "V1AiPolicy",
  "x-munim-module": "ai_policy",
  "type": "object",
  "properties": {
    "ceilings": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "staff",
              "advisor",
              "judge"
            ]
          },
          "mode_ceiling": {
            "type": "string",
            "enum": [
              "step",
              "plan",
              "auto"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "default",
              "set"
            ]
          }
        },
        "required": [
          "role",
          "mode_ceiling",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "cap": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "monthly_cap_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "monthly_cap_minor",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ceilings",
    "cap"
  ],
  "additionalProperties": false
}
