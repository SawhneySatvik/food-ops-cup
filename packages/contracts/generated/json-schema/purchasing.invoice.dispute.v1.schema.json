{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purchasing.invoice.dispute.v1",
  "title": "PurchasingInvoiceDisputeV1",
  "x-munim-module": "purchasing",
  "type": "object",
  "properties": {
    "dispute_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "supplier_invoice_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "basis": {
      "type": "string",
      "enum": [
        "overbilled",
        "duplicate_invoice",
        "other"
      ]
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoice_line_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "claimed_minor": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "invoice_line_id",
          "claimed_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dispute_id",
    "supplier_invoice_id",
    "basis",
    "lines"
  ],
  "additionalProperties": false
}
