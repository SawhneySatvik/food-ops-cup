{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.investigation.create.request",
  "title": "V1InvestigationCreateRequest",
  "x-munim-module": "investigations",
  "type": "object",
  "properties": {
    "investigation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "playbook_id": {
      "type": "string",
      "enum": [
        "margin_fall"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "period_month": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
        },
        "compare_month": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
        }
      },
      "required": [
        "period_month",
        "compare_month"
      ],
      "additionalProperties": false
    },
    "outlet_scope": {
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        {
          "minItems": 1,
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "const": "*"
          }
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "step",
        "plan",
        "auto"
      ]
    }
  },
  "required": [
    "investigation_id",
    "playbook_id",
    "params"
  ],
  "additionalProperties": false
}
