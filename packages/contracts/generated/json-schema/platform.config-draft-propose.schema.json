{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform.config-draft-propose",
  "title": "PlatformConfigDraftPropose",
  "x-munim-module": "platform",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z_]+(:[A-Za-z0-9_.-]+)?$"
    },
    "patch": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "target",
    "patch"
  ],
  "additionalProperties": false
}
