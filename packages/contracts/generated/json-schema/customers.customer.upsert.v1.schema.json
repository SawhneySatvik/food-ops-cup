{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customers.customer.upsert.v1",
  "title": "CustomersCustomerUpsertV1",
  "x-munim-module": "customers",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phone": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "withdraw_consent": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "sms"
        ]
      }
    }
  },
  "required": [
    "customer_id",
    "name",
    "phone",
    "email",
    "withdraw_consent"
  ],
  "additionalProperties": false
}
