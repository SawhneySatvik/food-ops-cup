{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.order.receipt",
  "title": "V1OrderReceipt",
  "x-munim-module": "orders",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tax_invoice",
        "record"
      ]
    },
    "title": {
      "type": "string"
    },
    "operator": {
      "type": [
        "string",
        "null"
      ]
    },
    "seller": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "address"
      ],
      "additionalProperties": false
    },
    "tax_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "qty_milli": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "amount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "discount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "net_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tax_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "total_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tax_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "rate_bp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "amount_minor": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "code",
                "rate_bp",
                "amount_minor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "line_no",
          "item_id",
          "name_key",
          "qty_milli",
          "unit_price_minor",
          "amount_minor",
          "discount_minor",
          "net_minor",
          "tax_minor",
          "total_minor",
          "tax_class",
          "components"
        ],
        "additionalProperties": false
      }
    },
    "net_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tax_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "total_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "rate_bp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "amount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "rate_bp",
          "amount_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "order_id",
    "kind",
    "title",
    "operator",
    "seller",
    "tax_ids",
    "number",
    "date",
    "currency",
    "lines",
    "net_minor",
    "tax_minor",
    "total_minor",
    "components"
  ],
  "additionalProperties": false
}
