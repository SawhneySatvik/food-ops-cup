{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.ingredient.upsert.v1",
  "title": "InventoryIngredientUpsertV1",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "ingredient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "base_unit": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{0,15}$"
    },
    "shelf_life_days": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "tracked_by_batch": {
      "type": "boolean"
    }
  },
  "required": [
    "ingredient_id",
    "name",
    "base_unit",
    "shelf_life_days",
    "tracked_by_batch"
  ],
  "additionalProperties": false
}
