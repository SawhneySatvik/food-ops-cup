{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "people.candidate.upsert.v1",
  "title": "PeopleCandidateUpsertV1",
  "x-munim-module": "people",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phone": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 254
        },
        {
          "type": "null"
        }
      ]
    },
    "role_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "applied",
        "interviewed",
        "offered",
        "hired",
        "rejected",
        "withdrawn"
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "candidate_id",
    "outlet_id",
    "name",
    "phone",
    "email",
    "role_key",
    "stage",
    "source",
    "note"
  ],
  "additionalProperties": false
}
