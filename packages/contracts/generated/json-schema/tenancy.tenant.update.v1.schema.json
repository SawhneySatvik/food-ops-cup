{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.tenant.update.v1",
  "title": "TenancyTenantUpdateV1",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "home_tz": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z]+\\/[A-Za-z_]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "complete_onboarding": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
