{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.menu.response",
  "title": "StorefrontMenuResponse",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "channel_kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "counter",
            "table_qr",
            "pickup",
            "own_site"
