  "required": [
    "outlet_id",
    "channel_id",
    "channel_kind",
    "brands",
    "prices_include_tax",
    "accepting",
    "items",
    "deals",
    "pay_at_counter",
    "pay_at_counter_methods"
  ],
  "additionalProperties": false
