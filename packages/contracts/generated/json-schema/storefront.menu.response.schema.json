                      },
                      "name_key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                      },
                      "display_name": {
                        "type": [
                          "string",
                          "null"
