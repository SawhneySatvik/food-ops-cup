                "display_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "min_select": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
