{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.drafts.request",
  "title": "InternalDraftsRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "command_type": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+\\.v[1-9][0-9]*$"
    },
    "payload": {
      "x-munim-draft-payload": "proposal",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "price_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "item_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "variant_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outlet_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "channel_kind": {
              "anyOf": [
                {
                  "type": "string",
