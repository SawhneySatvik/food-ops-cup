{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.wiki-batch.request",
  "title": "InternalWikiBatchRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "pages": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "body": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?:snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:row:[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:doc|msg|claim|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}))$"
                  }
                }
              },
              "required": [
                "text",
                "refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "page_id",
          "entity_id",
          "kind",
          "slug",
          "title",
          "version_id",
          "version",
          "body"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pages"
  ],
  "additionalProperties": false
}
