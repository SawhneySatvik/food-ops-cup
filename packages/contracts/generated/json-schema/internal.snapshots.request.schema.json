{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.snapshots.request",
  "title": "InternalSnapshotsRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "required": [
    "template_id",
    "params"
  ],
  "additionalProperties": false
}
