{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.reorder_level.set.v1",
  "title": "InventoryReorderLevelSetV1",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ingredient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "min_qty_milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "par_qty_milli": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "outlet_id",
    "ingredient_id",
    "min_qty_milli",
    "par_qty_milli"
  ],
  "additionalProperties": false
}
