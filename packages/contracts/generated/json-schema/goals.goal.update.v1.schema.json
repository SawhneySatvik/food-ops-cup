{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goals.goal.update.v1",
  "title": "GoalsGoalUpdateV1",
  "x-munim-module": "goals",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "achieved",
        "missed",
        "cancelled"
      ]
    }
  },
  "required": [
    "goal_id",
    "status"
  ],
  "additionalProperties": false
}
