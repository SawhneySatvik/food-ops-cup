{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.people.payroll-preview.response",
  "title": "V1PeoplePayrollPreviewResponse",
  "x-munim-module": "people",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "period_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-01$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "base_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "overtime_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "advance_recovery_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tips_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "net_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "outstanding_advance_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "staff_id",
          "base_minor",
          "overtime_minor",
          "advance_recovery_minor",
          "tips_minor",
          "net_minor",
          "outstanding_advance_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlet_id",
    "period_month",
    "currency",
    "lines"
  ],
  "additionalProperties": false
}
