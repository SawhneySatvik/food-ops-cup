{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.outlets",
  "title": "V1Outlets",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "cloud_kitchen",
              "store"
            ]
          },
          "tz": {
            "type": "string",
            "pattern": "^[A-Za-z]+\\/[A-Za-z_]+$"
          },
          "address": {
            "type": "string"
          },
          "tax_ids": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "accepting_orders": {
            "type": "string",
            "enum": [
              "open",
              "busy",
              "paused"
            ]
          },
          "busy_extra_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          },
          "default_prep_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          },
          "cancel_window_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "reschedule_window_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "pickup_slot_min": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "pickup_lead_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "upi_vpa": {
            "type": [
              "string",
              "null"
            ]
          },
          "business_day_cutoff": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "tz",
          "address",
          "tax_ids",
          "accepting_orders",
          "busy_extra_min",
          "default_prep_min",
          "cancel_window_min",
          "reschedule_window_min",
          "pickup_slot_min",
          "pickup_lead_min",
          "upi_vpa",
          "business_day_cutoff",
          "phone"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlets"
  ],
  "additionalProperties": false
}
