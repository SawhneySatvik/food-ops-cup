{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.policy.set.v1",
  "title": "TenancyPolicySetV1",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "outlet_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    },
    "labour_target_bp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "target_margin_bp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "margin_floor_bp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "min_payment_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "negotiation_target_bp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "negotiation_walkaway_bp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    }
  },
  "required": [
    "outlet_id",
    "valid_from"
  ],
  "additionalProperties": false
}
