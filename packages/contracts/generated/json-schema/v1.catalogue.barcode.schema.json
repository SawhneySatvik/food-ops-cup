{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.catalogue.barcode",
  "title": "V1CatalogueBarcode",
  "x-munim-module": "catalogue",
  "type": "object",
  "properties": {
    "barcode": {
      "type": "string"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "variant_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "on_sale": {
      "type": "boolean"
    },
    "entry": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "variant_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "dish",
                "sku",
                "combo"
              ]
            },
            "name_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "variant_name_key": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "category": {
              "type": "string"
            },
            "barcode": {
              "type": [
                "string",
                "null"
              ]
            },
            "price_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "price_minor": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "tax_class": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "mrp_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "available": {
              "type": "boolean"
            },
            "option_groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option_group_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "name_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                  },
                  "min_select": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max_select": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "option_id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "name_key": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                        },
                        "price_delta_minor": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        }
                      },
                      "required": [
                        "option_id",
                        "name_key",
                        "price_delta_minor",
                        "currency"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "option_group_id",
                  "name_key",
                  "min_select",
                  "max_select",
                  "required",
                  "options"
                ],
                "additionalProperties": false
              }
            },
            "deals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "deal_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "name_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "windows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "days": {
                          "minItems": 1,
                          "maxItems": 7,
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 7
                          }
                        },
                        "from": {
                          "type": "string",
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        }
                      },
                      "required": [
                        "days",
                        "from",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "deal_id",
                  "name_key",
                  "kind",
                  "windows"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "item_id",
            "variant_id",
            "kind",
            "name_key",
            "variant_name_key",
            "category",
            "barcode",
            "price_id",
            "price_minor",
            "currency",
            "tax_class",
            "mrp_minor",
            "available",
            "option_groups",
            "deals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "barcode",
    "item_id",
    "variant_id",
    "on_sale",
    "entry"
  ],
  "additionalProperties": false
}
