{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purchasing.supplier_return.create.v1",
  "title": "PurchasingSupplierReturnCreateV1",
  "x-munim-module": "purchasing",
  "type": "object",
  "properties": {
    "supplier_return_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "supplier_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "goods_received_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batch_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "qty_milli": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,15}$"
          }
        },
        "required": [
          "batch_id",
          "ingredient_id",
          "qty_milli",
          "unit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "supplier_return_id",
    "outlet_id",
    "supplier_id",
    "goods_received_id",
    "reason_code",
    "note",
    "lines"
  ],
  "additionalProperties": false
}
