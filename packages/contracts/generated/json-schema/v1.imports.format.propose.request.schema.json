{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.imports.format.propose.request",
  "title": "V1ImportsFormatProposeRequest",
  "x-munim-module": "imports",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "payout_statement",
        "bank_statement",
        "pos_export",
        "tally_export",
        "market_signal",
        "pos_bills",
        "waste_log",
        "shift_log",
        "stock_count"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "mapping": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,15}$"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "document_id",
    "kind",
    "name",
    "mapping"
  ],
  "additionalProperties": false
}
