{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customers.loyalty.adjust.v1",
  "title": "CustomersLoyaltyAdjustV1",
  "x-munim-module": "customers",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "points": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "customer_id",
    "points",
    "note"
  ],
  "additionalProperties": false
}
