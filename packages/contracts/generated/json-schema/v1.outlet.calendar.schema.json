{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.outlet.calendar",
  "title": "V1OutletCalendar",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tz": {
      "type": "string",
      "pattern": "^[A-Za-z]+\\/[A-Za-z_]+$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calendar_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "weekly",
              "override"
            ]
          },
          "weekday": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              {
                "type": "null"
              }
            ]
          },
          "on_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "opens_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closes_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closed": {
            "type": "boolean"
          }
        },
        "required": [
          "calendar_id",
          "kind",
          "weekday",
          "on_date",
          "opens_at",
          "closes_at",
          "closed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlet_id",
    "tz",
    "rows"
  ],
  "additionalProperties": false
}
