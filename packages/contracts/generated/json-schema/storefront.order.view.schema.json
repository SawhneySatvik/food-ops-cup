      "maximum": 9007199254740991
    },
    "reschedule_window_min": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pay_at_counter": {
      "type": "boolean",
      "const": true
    },
    "prices_include_tax": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "variant_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "line_discount_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tax_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tax_rate_bp": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "tax_component_rates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "rate_bp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "code",
                "rate_bp"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "line_no",
          "item_id",
          "variant_id",
          "qty_milli",
          "unit_price_minor",
          "line_discount_minor",
          "tax_minor",
          "tax_rate_bp",
          "tax_component_rates"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
