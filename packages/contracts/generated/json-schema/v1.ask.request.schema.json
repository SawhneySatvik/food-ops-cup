{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.ask.request",
  "title": "V1AskRequest",
  "x-munim-module": "threads",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "thread_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deep": {
      "type": "boolean"
    }
  },
  "required": [
    "question"
  ],
  "additionalProperties": false
}
