{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.me.tenants",
  "title": "TenancyMeTenants",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "tenant_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "manager",
              "staff",
              "advisor",
              "judge"
            ]
          }
        },
        "required": [
          "tenant_id",
          "tenant_name",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tenants"
  ],
  "additionalProperties": false
}
