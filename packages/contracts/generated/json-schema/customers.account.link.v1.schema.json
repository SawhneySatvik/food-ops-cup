{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customers.account.link.v1",
  "title": "CustomersAccountLinkV1",
  "x-munim-module": "accounts",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "phone": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "additionalProperties": false
}
