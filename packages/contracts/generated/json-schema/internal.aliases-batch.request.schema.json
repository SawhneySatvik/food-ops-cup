{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.aliases-batch.request",
  "title": "InternalAliasesBatchRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "aliases": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "type": "string",
            "enum": [
              "core",
              "claim",
              "import",
              "member"
            ]
          }
        },
        "required": [
          "id",
          "entity_id",
          "alias",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "aliases"
  ],
  "additionalProperties": false
}
