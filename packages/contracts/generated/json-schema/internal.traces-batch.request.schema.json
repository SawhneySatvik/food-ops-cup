{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.traces-batch.request",
  "title": "InternalTracesBatchRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "events": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "parent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,99}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "route",
                  "skill_load",
                  "subagent_start",
                  "subagent_end",
                  "tool_call",
                  "tool_result",
                  "a2a_send",
                  "a2a_receive",
                  "finding",
                  "draft",
                  "abstain",
                  "error"
                ]
              },
              "payload": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "seq",
              "parent_id",
              "actor",
              "at",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "parent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,99}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
              },
              "kind": {
                "type": "string",
                "const": "review"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "cannot_verify"
                    ]
                  },
                  "reason_code": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "number_grammar",
                          "unresolved_ref",
                          "cross_tenant_ref",
                          "quote_mismatch",
                          "missing_ref",
                          "settlements_missing",
                          "recipe_missing",
                          "stale_draft",
                          "authority_denied",
                          "cost_price_missing",
                          "ticket_times_missing",
                          "count_missing",
                          "expiry_missing",
                          "budget_exceeded",
                          "budget_missing",
                          "margin_below_floor",
                          "moq_exceeds_need",
                          "open_commitment_overlap",
                          "payment_terms_worse",
                          "consent_record_missing",
                          "bank_lines_missing",
                          "attendance_missing",
                          "payroll_out_of_scope",
                          "no_marketing_consent",
                          "not_a_certificate",
                          "log_coverage_missing",
                          "signal_source_missing",
                          "insufficient_history",
                          "forecast_stale",
                          "window_full",
                          "outlet_paused",
                          "item_sold_out",
                          "deal_rejudged",
                          "coupon_invalid",
                          "coupon_cap_reached",
                          "coupon_min_spend",
                          "change_window_closed",
                          "price_above_mrp",
                          "expired_batch",
                          "period_closed",
                          "model_blocked",
                          "preview_total_changed",
                          "buyer_identity_required",
                          "tax_id_missing",
                          "unknown_tax_class",
                          "unknown_channel",
                          "unit_mismatch"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "refs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:row:[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:doc|msg|claim|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}))$"
                    }
                  },
                  "subject_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "verdict",
                  "reason_code",
                  "refs",
                  "subject_id"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "seq",
              "parent_id",
              "actor",
              "at",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}
