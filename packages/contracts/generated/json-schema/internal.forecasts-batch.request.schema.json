{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.forecasts-batch.request",
  "title": "InternalForecastsBatchRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "forecast_run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "trained_through": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "holdout_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wape_bp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_wape_bp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "bias_bp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "method",
        "trained_through",
        "horizon_days",
        "holdout_days",
        "wape_bp",
        "baseline_wape_bp",
        "bias_bp"
      ],
      "additionalProperties": false
    },
    "points": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "outlet_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "business_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
          },
          "slot_start": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "qty_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lo_qty_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hi_qty_milli": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "inputs_snapshot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "id",
          "outlet_id",
          "item_id",
          "business_on",
          "slot_start",
          "method",
          "qty_milli",
          "lo_qty_milli",
          "hi_qty_milli",
          "inputs_snapshot_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "forecast_run",
    "points"
  ],
  "additionalProperties": false
}
