{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kitchen.ticket.advance.v1",
  "title": "KitchenTicketAdvanceV1",
  "x-munim-module": "kitchen",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from_status": {
      "type": "string",
      "enum": [
        "queued",
        "preparing",
        "ready",
        "done"
      ]
    },
    "to_status": {
      "type": "string",
      "enum": [
        "queued",
        "preparing",
        "ready",
        "done"
      ]
    }
  },
  "required": [
    "ticket_id",
    "from_status",
    "to_status"
  ],
  "additionalProperties": false
}
