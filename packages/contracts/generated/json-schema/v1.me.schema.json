{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.me",
  "title": "V1Me",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "staff",
        "advisor",
        "judge"
      ]
    },
    "outlet_ids": {
      "anyOf": [
        {
          "type": "string",
          "const": "*"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      ]
    }
  },
  "required": [
    "member_id",
    "tenant_id",
    "name",
    "role",
    "outlet_ids"
  ],
  "additionalProperties": false
}
