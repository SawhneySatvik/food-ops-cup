{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.traces.response",
  "title": "V1TracesResponse",
  "x-munim-module": "intel",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "parent_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{0,99}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "route",
                  "skill_load",
                  "subagent_start",
                  "subagent_end",
                  "tool_call",
                  "tool_result",
                  "a2a_send",
                  "a2a_receive",
                  "finding",
                  "draft",
                  "abstain",
                  "error"
                ]
              },
              "payload": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?![0-9][0-9.]{3,}$)[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(?![0-9][0-9.]{3,}$)[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "run_id",
              "id",
              "seq",
              "parent_id",
              "actor",
              "at",
              "kind",
              "payload"
            ],
            "additionalProperties": false
          },
          {
