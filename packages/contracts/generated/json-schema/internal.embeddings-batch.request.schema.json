{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.embeddings-batch.request",
  "title": "InternalEmbeddingsBatchRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "embeddings": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "embedding_micro": {
            "minItems": 768,
            "maxItems": 768,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "required": [
          "chunk_id",
          "embedding_micro"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "embeddings"
  ],
  "additionalProperties": false
}
