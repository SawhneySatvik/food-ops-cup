{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.order.placed",
  "title": "StorefrontOrderPlaced",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "accepted",
        "rejected",
        "preparing",
        "ready",
        "completed",
        "cancelled"
      ]
    },
    "ticket_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "total_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tax_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "prices_include_tax": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "promised_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pay_at_counter": {
      "type": "boolean",
      "const": true
    },
    "guest_access_token": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "order_id",
    "status",
    "ticket_no",
    "total_minor",
    "tax_minor",
    "prices_include_tax",
    "currency",
    "promised_at",
    "pay_at_counter",
    "guest_access_token"
  ],
  "additionalProperties": false
}
