{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.order.place.request",
  "title": "StorefrontOrderPlaceRequest",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "order": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{8,100}$"
        },
        "type": {
          "type": "string",
          "const": "orders.place.v1"
        },
        "payload": {
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "outlet_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "channel_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "brand_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "device_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "dine_in",
                "takeaway",
                "pickup",
                "delivery"
              ]
            },
            "table_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                {
                  "type": "null"
                }
              ]
            },
            "pickup_window_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "promised_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "external_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "lines": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "line_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "item_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "variant_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "option_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  },
                  "qty_milli": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "barcode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9A-Za-z-]{4,32}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "line_id",
                  "item_id",
                  "variant_id",
                  "option_ids",
                  "qty_milli",
                  "barcode",
                  "note"
                ],
                "additionalProperties": false
              }
            },
            "coupon_codes": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9-]{2,31}$"
              }
            },
            "loyalty_redeem_points": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "preview_total_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "client_totals": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "subtotal": {
                      "type": "object",
                      "properties": {
                        "amount_minor": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        }
                      },
                      "required": [
                        "amount_minor",
                        "currency"
                      ],
                      "additionalProperties": false
                    },
                    "total": {
                      "type": "object",
                      "properties": {
                        "amount_minor": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        }
                      },
                      "required": [
                        "amount_minor",
                        "currency"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "subtotal",
                    "total"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "order_id",
            "outlet_id",
            "channel_id",
            "brand_id",
            "device_id",
            "kind",
            "table_ref",
            "pickup_window_id",
            "promised_at",
            "external_ref",
            "lines",
            "coupon_codes",
            "loyalty_redeem_points",
            "preview_total_minor",
            "client_totals"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command_id",
        "idempotency_key",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "guest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "command_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "idempotency_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,100}$"
            },
            "type": {
              "type": "string",
              "const": "storefront.guest.create.v1"
            },
            "payload": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "phone": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\+[1-9][0-9]{6,14}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "email": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 254,
                      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "consent": {
                  "type": "object",
                  "properties": {
                    "marketing": {
                      "type": "boolean"
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
                    }
                  },
                  "required": [
                    "marketing",
                    "at"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "phone",
                "email",
                "consent"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command_id",
            "idempotency_key",
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "contact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\+[1-9][0-9]{6,14}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "phone"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "order",
    "guest",
    "contact"
  ],
  "additionalProperties": false
}
