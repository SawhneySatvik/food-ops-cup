{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.storefront-key.create",
  "title": "TenancyStorefrontKeyCreate",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "allowed_origins": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?:\\/\\/[^/\\s]+$"
      }
    }
  },
  "required": [
    "key_id",
    "channel_id",
    "allowed_origins"
  ],
  "additionalProperties": false
}
