{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drafts.reject.v1",
  "title": "DraftsRejectV1",
  "x-munim-module": "approvals",
  "type": "object",
  "properties": {
    "draft_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "wrong_numbers",
        "not_needed",
        "already_done",
        "bad_timing",
        "other"
      ]
    }
  },
  "required": [
    "draft_id",
    "reason"
  ],
  "additionalProperties": false
}
