{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cares.handover.void.v1",
  "title": "CaresHandoverVoidV1",
  "x-munim-module": "cares",
  "type": "object",
  "properties": {
    "handover_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  },
  "required": [
    "handover_id",
    "reason_code"
  ],
  "additionalProperties": false
}
