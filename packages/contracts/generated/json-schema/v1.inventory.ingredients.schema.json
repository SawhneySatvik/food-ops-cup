{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.inventory.ingredients",
  "title": "V1InventoryIngredients",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string"
          },
          "base_unit": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,15}$"
          },
          "shelf_life_days": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tracked_by_batch": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "ingredient_id",
          "name",
          "base_unit",
          "shelf_life_days",
          "tracked_by_batch",
          "active"
        ],
        "additionalProperties": false,
        "title": "IngredientItem"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "additionalProperties": false
}
