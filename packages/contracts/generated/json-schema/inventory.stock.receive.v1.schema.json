{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.stock.receive.v1",
  "title": "InventoryStockReceiveV1",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source": {
      "type": "string",
      "const": "opening"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "movement_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "batch": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "batch_code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "expires_on": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mrp_minor": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "batch_code",
                  "expires_on",
                  "mrp_minor"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,15}$"
          },
          "unit_cost": {
            "type": "object",
            "properties": {
              "amount_minor": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount_minor",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "movement_id",
          "ingredient_id",
          "batch_id",
          "batch",
          "qty_milli",
          "unit",
          "unit_cost"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlet_id",
    "source",
    "at",
    "lines"
  ],
  "additionalProperties": false
}
