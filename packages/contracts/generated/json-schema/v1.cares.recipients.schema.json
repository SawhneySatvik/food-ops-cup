{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.cares.recipients",
  "title": "V1CaresRecipients",
  "x-munim-module": "cares",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recipient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "city_code": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "ngo",
              "food_bank"
            ]
          },
          "simulated": {
            "type": "boolean",
            "const": true
          },
          "accepts_cooked": {
            "type": "boolean"
          },
          "accepts_raw": {
            "type": "boolean"
          },
          "accepts_packaged": {
            "type": "boolean"
          },
          "capacity_kg_per_day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capacity_portions_per_day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "receiving_from": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "receiving_to": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "lat_e6": {
            "type": "integer",
            "minimum": -90000000,
            "maximum": 90000000
          },
          "lng_e6": {
            "type": "integer",
            "minimum": -180000000,
            "maximum": 180000000
          }
        },
        "required": [
          "recipient_id",
          "city_code",
          "name",
          "kind",
          "simulated",
          "accepts_cooked",
          "accepts_raw",
          "accepts_packaged",
          "capacity_kg_per_day",
          "capacity_portions_per_day",
          "receiving_from",
          "receiving_to",
          "lat_e6",
          "lng_e6"
        ],
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "const": "Measured on synthetic data"
        },
        "recipients": {
          "type": "string",
          "const": "to simulated recipients"
        }
      },
      "required": [
        "data",
        "recipients"
      ],
      "additionalProperties": false
    },
    "note_key": {
      "type": "string",
      "const": "cares.note.check_local_rules"
    }
  },
  "required": [
    "items",
    "labels",
    "note_key"
  ],
  "additionalProperties": false
}
