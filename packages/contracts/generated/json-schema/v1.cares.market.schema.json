{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.cares.market",
  "title": "V1CaresMarket",
  "x-munim-module": "cares",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offer_tenant_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "listing_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "business_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "outlet_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "city_code": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "pickup_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
          },
          "pickup_to": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
          },
          "pickup_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offer_line_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "food_kind": {
                  "type": "string",
                  "enum": [
                    "cooked",
                    "raw",
                    "packaged"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "qty_milli": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]{0,15}$"
                },
                "expires_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unit_price_minor": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              },
              "required": [
                "offer_line_id",
                "food_kind",
                "label",
                "qty_milli",
                "unit",
                "expires_on",
                "unit_price_minor",
                "currency"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "offer_tenant_id",
          "listing_id",
          "business_name",
          "outlet_name",
          "city_code",
          "pickup_from",
          "pickup_to",
          "pickup_on",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "const": "Measured on synthetic data"
        },
        "recipients": {
          "type": "string",
          "const": "to simulated recipients"
        }
      },
      "required": [
        "data",
        "recipients"
      ],
      "additionalProperties": false
    },
    "note_key": {
      "type": "string",
      "const": "cares.note.check_local_rules"
    },
    "money_label": {
      "type": "string",
      "const": "Recorded, never processed"
    }
  },
  "required": [
    "items",
    "labels",
    "note_key",
    "money_label"
  ],
  "additionalProperties": false
}
