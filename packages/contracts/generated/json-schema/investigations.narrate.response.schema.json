{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investigations.narrate.response",
  "title": "InvestigationsNarrateResponse",
  "x-munim-module": "investigations",
  "type": "object",
  "properties": {
    "answer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tainted": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "model",
        "template"
      ]
    }
  },
  "required": [
    "answer_id",
    "tainted",
    "source"
  ],
  "additionalProperties": false
}
