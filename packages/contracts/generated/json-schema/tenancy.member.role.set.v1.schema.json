{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.member.role.set.v1",
  "title": "TenancyMemberRoleSetV1",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "member_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "staff",
        "advisor"
      ]
    },
    "outlet_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  },
  "required": [
    "member_id",
    "role",
    "outlet_ids"
  ],
  "additionalProperties": false
}
