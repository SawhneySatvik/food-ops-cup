{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.brands",
  "title": "V1Brands",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "outlet_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "outlet_ids",
          "active"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "brands"
  ],
  "additionalProperties": false
}
