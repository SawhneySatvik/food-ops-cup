{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.page.public",
  "title": "StorefrontPagePublic",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "page": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "published_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
            },
            "doc": {
              "type": "object",
              "properties": {
                "theme": {
                  "type": "object",
                  "properties": {
                    "primary": {
                      "type": "string",
                      "pattern": "^#[0-9a-f]{6}$"
                    },
                    "secondary": {
                      "type": "string",
                      "pattern": "^#[0-9a-f]{6}$"
                    },
                    "accent": {
                      "type": "string",
                      "pattern": "^#[0-9a-f]{6}$"
                    },
                    "radius": {
                      "type": "string",
                      "enum": [
                        "soft",
                        "round"
                      ]
                    },
                    "layout": {
                      "type": "string",
                      "enum": [
                        "hero-banner",
                        "menu-grid",
                        "menu-list"
                      ]
                    }
                  },
                  "required": [
                    "primary",
                    "secondary",
                    "accent",
                    "radius",
                    "layout"
                  ],
                  "additionalProperties": false
                },
                "sections": {
                  "minItems": 4,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "hero"
                          },
                          "visible": {
                            "type": "boolean"
                          },
                          "badge": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 60
                          },
                          "tagline": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        },
                        "required": [
                          "kind",
                          "visible",
                          "badge",
                          "tagline"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "outlets"
                          },
                          "visible": {
                            "type": "boolean",
                            "const": true
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 60
                          }
                        },
                        "required": [
                          "kind",
                          "visible",
                          "title"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "ribbon"
                          },
                          "visible": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "kind",
                          "visible"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "cards"
                          },
                          "visible": {
                            "type": "boolean"
                          },
                          "cards": {
                            "minItems": 2,
                            "maxItems": 2,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                },
                                "body": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 240
                                }
                              },
                              "required": [
                                "title",
                                "body"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "visible",
                          "cards"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "theme",
                "sections"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "published_at",
            "doc"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "page"
  ],
  "additionalProperties": false
}
