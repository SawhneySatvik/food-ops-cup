{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.supplier-return",
  "title": "V1SupplierReturn",
  "x-munim-module": "purchasing",
  "type": "object",
  "properties": {
    "supplier_return_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "supplier": {
      "type": "object",
      "properties": {
        "supplier_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "real",
            "simulated"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "const": "Simulated supplier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "supplier_id",
        "name",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "goods_received_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "returned_by": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "returned_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "batch_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "qty_milli": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,15}$"
          },
          "unit_cost_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "unit_cost_per_1000_minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "ingredient_id",
          "batch_id",
          "qty_milli",
          "unit",
          "unit_cost_minor",
          "unit_cost_per_1000_minor",
          "currency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "supplier_return_id",
    "outlet_id",
    "supplier",
    "goods_received_id",
    "reason_code",
    "note",
    "returned_by",
    "returned_at",
    "lines"
  ],
  "additionalProperties": false
}
