{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalogue.availability.set.v1",
  "title": "CatalogueAvailabilitySetV1",
  "x-munim-module": "catalogue",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "variant_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "available": {
      "type": "boolean"
    }
  },
  "required": [
    "outlet_id",
    "item_id",
    "variant_id",
    "available"
  ],
  "additionalProperties": false
}
