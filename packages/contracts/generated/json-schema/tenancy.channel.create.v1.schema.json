{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.channel.create.v1",
  "title": "TenancyChannelCreateV1",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "counter",
            "table_qr",
            "pickup",
            "own_site"
          ]
        },
        {
          "type": "string",
          "pattern": "^aggregator:[a-z][a-z0-9_]*$"
        }
      ]
    }
  },
  "required": [
    "channel_id",
    "name",
    "kind"
  ],
  "additionalProperties": false
}
