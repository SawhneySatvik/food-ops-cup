{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.spend.request",
  "title": "InternalSpendRequest",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "entries": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "router",
              "reason",
              "extract",
              "narrate",
              "vision",
              "embed"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "gemini",
              "openai",
              "openrouter",
              "nvidia"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "id",
          "role",
          "provider",
          "model_id",
          "input_tokens",
          "output_tokens",
          "amount_minor",
          "currency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
