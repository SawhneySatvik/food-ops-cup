{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "purchasing.supplier.upsert.v1",
  "title": "PurchasingSupplierUpsertV1",
  "x-munim-module": "purchasing",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "real",
        "simulated"
      ]
    },
    "a2a_card_url": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?:\\/\\/\\S+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "terms": {
      "type": "object",
      "properties": {
        "payment_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "payment_days",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "supplier_id",
    "name",
    "kind",
    "a2a_card_url",
    "terms"
  ],
  "additionalProperties": false
}
