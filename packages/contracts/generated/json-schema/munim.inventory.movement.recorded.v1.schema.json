{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "munim.inventory.movement.recorded.v1",
  "title": "MunimInventoryMovementRecordedV1",
  "x-munim-module": "events",
  "type": "object",
  "properties": {
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))T(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|([+-](?:[01][0-9]|2[0-3]):[0-5][0-9])))$"
    },
    "datacontenttype": {
      "type": "string",
      "const": "application/json"
    },
    "tenantid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "munimrun": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^\\/tenants\\/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\/inventory$"
    },
    "type": {
      "type": "string",
      "const": "munim.inventory.movement.recorded.v1"
    },
    "subject": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "outlet_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "movement_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "ingredient_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "receipt",
            "sale_consumption",
            "waste",
            "transfer_out",
            "transfer_in",
            "count_adjust",
            "supplier_return",
            "sale_return",
            "donation",
            "surplus_out",
            "surplus_in",
            "cares_reversal"
          ]
        },
        "ref_type": {
          "type": "string",
          "pattern": "^core\\.[a-z_]+$"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "outlet_id",
        "movement_ids",
        "ingredient_ids",
        "kind",
        "ref_type",
        "ref_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "specversion",
    "id",
    "time",
    "datacontenttype",
    "tenantid",
    "munimrun",
    "source",
    "type",
    "subject",
    "data"
  ],
  "additionalProperties": false
}
