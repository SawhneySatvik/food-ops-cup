{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.waste.record.v1",
  "title": "InventoryWasteRecordV1",
  "x-munim-module": "inventory",
  "type": "object",
  "properties": {
    "waste_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ingredient_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "batch_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "qty_milli": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "unit": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{0,15}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "temperature",
        "overprep",
        "expired",
        "damaged",
        "other"
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "waste_id",
    "outlet_id",
    "ingredient_id",
    "batch_id",
    "qty_milli",
    "unit",
    "reason",
    "note"
  ],
  "additionalProperties": false
}
