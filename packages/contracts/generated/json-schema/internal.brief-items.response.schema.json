{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal.brief-items.response",
  "title": "InternalBriefItemsResponse",
  "x-munim-module": "internal",
  "type": "object",
  "properties": {
    "items": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "pack": {
            "type": "string",
            "enum": [
              "catalogue",
              "kitchen",
              "inventory_purchasing",
              "finance",
              "people",
              "customers",
              "compliance",
              "market"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "texts": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "impact_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^⟨snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}·(?:0|[1-9][0-9]*)·[a-z_][a-z0-9_]*⟩$"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "finding_id",
          "pack",
          "severity",
          "type",
          "texts",
          "impact_ref",
          "draft_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
