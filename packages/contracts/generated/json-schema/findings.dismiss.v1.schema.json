{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.dismiss.v1",
  "title": "FindingsDismissV1",
  "x-munim-module": "findings",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "wrong_numbers",
        "not_needed",
        "already_done",
        "bad_timing",
        "other"
      ]
    }
  },
  "required": [
    "finding_id",
    "reason_code"
  ],
  "additionalProperties": false
}
