{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance.checklist.upsert.v1",
  "title": "ComplianceChecklistUpsertV1",
  "x-munim-module": "compliance",
  "type": "object",
  "properties": {
    "checklist_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "opening",
        "closing",
        "hygiene",
        "cleaning",
        "other"
      ]
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "due_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "items": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
      }
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "checklist_id",
    "outlet_id",
    "name_key",
    "kind",
    "frequency",
    "due_time",
    "items",
    "active"
  ],
  "additionalProperties": false
}
