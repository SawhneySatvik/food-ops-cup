{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kitchen.prep_time.set.v1",
  "title": "KitchenPrepTimeSetV1",
  "x-munim-module": "kitchen",
  "type": "object",
  "properties": {
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "station": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "prep_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:[0-9][0-9][2468][048]|[0-9][0-9][13579][26]|[0-9][0-9]0[48]|[02468][048]00|[13579][26]00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|(?:02)-(?:0[1-9]|1[0-9]|2[0-8])))$"
    }
  },
  "required": [
    "outlet_id",
    "item_id",
    "station",
    "prep_sec",
    "valid_from"
  ],
  "additionalProperties": false
}
