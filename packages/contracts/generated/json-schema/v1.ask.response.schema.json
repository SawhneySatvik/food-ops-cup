{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1.ask.response",
  "title": "V1AskResponse",
  "x-munim-module": "threads",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "turn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "turn_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "addressed_to": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "catalogue",
                "kitchen",
                "inventory_purchasing",
                "finance",
                "people",
                "customers",
                "compliance",
                "market"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "tainted": {
          "type": "boolean"
        }
      },
      "required": [
        "turn_id",
        "turn_no",
        "addressed_to",
        "tainted"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "answer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "envelope": {
          "type": "object",
          "properties": {
            "answer_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?:snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:row:[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:doc|msg|claim|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}))$"
                    }
                  }
                },
                "required": [
                  "text",
                  "refs"
                ],
                "additionalProperties": false
              }
            },
            "abstained": {
              "type": "boolean"
            },
            "reason_code": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "number_grammar",
                    "unresolved_ref",
                    "cross_tenant_ref",
                    "quote_mismatch",
                    "missing_ref",
                    "settlements_missing",
                    "recipe_missing",
                    "stale_draft",
                    "authority_denied",
                    "cost_price_missing",
                    "ticket_times_missing",
                    "count_missing",
                    "expiry_missing",
                    "budget_exceeded",
                    "budget_missing",
                    "margin_below_floor",
                    "moq_exceeds_need",
                    "open_commitment_overlap",
                    "payment_terms_worse",
                    "consent_record_missing",
                    "bank_lines_missing",
                    "attendance_missing",
                    "payroll_out_of_scope",
                    "no_marketing_consent",
                    "not_a_certificate",
                    "log_coverage_missing",
                    "signal_source_missing",
                    "insufficient_history",
                    "forecast_stale",
                    "window_full",
                    "outlet_paused",
                    "item_sold_out",
                    "deal_rejudged",
                    "coupon_invalid",
                    "coupon_cap_reached",
                    "coupon_min_spend",
                    "change_window_closed",
                    "coupon_expired",
                    "coupon_out_of_scope",
                    "price_above_mrp",
                    "expired_batch",
                    "period_closed",
                    "model_blocked",
                    "preview_total_changed",
                    "buyer_identity_required",
                    "tax_id_missing",
                    "unknown_tax_class",
                    "unknown_channel",
                    "unit_mismatch",
                    "not_applicable",
                    "item_unavailable",
                    "reason_required",
                    "deal_changed",
                    "duplicate_invoice",
                    "guest_cannot_change",
                    "refund_first",
                    "order_tendered",
                    "cash_below_rounding",
                    "recently_rejected",
                    "mode_above_ceiling",
                    "cap_above_platform_budget",
                    "platform_budget_missing",
                    "assignee_missing",
                    "campaign_audience_unscoped",
                    "specialist_needed",
                    "cares_not_available",
                    "cares_not_enabled",
                    "cares_not_opted_in",
                    "cares_city_mismatch",
                    "recipient_ineligible",
                    "listing_expired",
                    "qty_exceeds_on_hand",
                    "qty_exceeds_listed",
                    "cooked_hold_exceeded",
                    "line_expired",
                    "no_eligible_recipient",
                    "no_rostered_staff",
                    "offer_not_enabled",
                    "offer_closed",
                    "claim_decided",
                    "claim_received",
                    "rate_limited",
                    "handover_must_be_complete",
                    "offer_handover_final",
                    "pickup_time_outside_window",
                    "theme_contrast",
                    "page_version_stale",
                    "demo_only",
                    "demo_protected"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "follow_up": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "dig_deeper"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "answer_id",
            "segments",
            "abstained"
          ],
          "additionalProperties": false
        },
        "resolved_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^(?:⟨snap:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}·(?:0|[1-9][0-9]*)·[a-z_][a-z0-9_]*⟩|⟨cite:(?:row:[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|(?:doc|msg|claim|snapshot):[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})(?:·(?:0|[1-9][0-9]*)-(?:0|[1-9][0-9]*))?⟩)$"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ref",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "signature": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "enum": [
                "answer.signature.via_manager",
                "answer.signature.manager"
              ]
            },
            "specialist": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "catalogue",
                    "kitchen",
                    "inventory_purchasing",
                    "finance",
                    "people",
                    "customers",
                    "compliance",
                    "market"
                  ]
                },
                {
                  "type": "string",
                  "const": "manager"
                }
              ]
            },
            "name_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "key",
            "specialist",
            "name_key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "answer_id",
        "envelope",
        "resolved_refs",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "thread_id",
    "turn",
    "answer"
  ],
  "additionalProperties": false
}
