{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenancy.device.register.v1",
  "title": "TenancyDeviceRegisterV1",
  "x-munim-module": "tenancy",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outlet_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "pos",
        "kds"
      ]
    },
    "invoice_series": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{0,15}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "device_id",
    "outlet_id",
    "kind",
    "invoice_series"
  ],
  "additionalProperties": false
}
