{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform.model-role",
  "title": "PlatformModelRole",
  "x-munim-module": "platform",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "router",
        "reason",
        "extract",
        "narrate",
        "vision",
        "embed"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "gemini",
        "openai",
        "openrouter",
        "nvidia"
      ]
    },
    "model_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
    },
    "input_price_per_mtok_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_price_per_mtok_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "price_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "required": [
    "role",
    "provider",
    "model_id"
  ],
  "additionalProperties": false
}
