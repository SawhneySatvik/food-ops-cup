{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.outlets.response",
  "title": "StorefrontOutletsResponse",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "outlet_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "cloud_kitchen",
              "store"
            ]
          },
          "tz": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "outlet_id",
          "name",
          "kind",
          "tz",
          "address"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outlets"
  ],
  "additionalProperties": false
}
