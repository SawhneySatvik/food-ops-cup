{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.outlets.response",
  "title": "StorefrontOutletsResponse",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "outlet_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "cloud_kitchen",
              "store"
            ]
          },
          "tz": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "tax_ids": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "outlet_id",
          "name",
          "kind",
          "tz",
          "address",
          "phone",
          "tax_ids"
        ],
        "additionalProperties": false
      }
    },
    "pay_at_counter_methods": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cash",
              "card",
              "upi"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "outlets",
    "pay_at_counter_methods"
  ],
  "additionalProperties": false
}
