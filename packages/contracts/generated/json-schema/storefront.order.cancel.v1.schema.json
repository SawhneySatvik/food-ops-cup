{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storefront.order.cancel.v1",
  "title": "StorefrontOrderCancelV1",
  "x-munim-module": "storefront",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "changed_mind",
            "ordered_by_mistake",
            "wait_too_long",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "order_id",
    "reason"
  ],
  "additionalProperties": false
}
